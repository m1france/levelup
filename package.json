{
  "name": "atelier",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Atelier — l'application terrain des éducateurs : exercices animés, séances live, pages joueurs.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,green \"API_PORT=3000 node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
